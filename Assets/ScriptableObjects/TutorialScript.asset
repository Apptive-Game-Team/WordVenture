--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bd6c2109ca2ccd441802e1d59fc530ae, type: 3}
  m_Name: TutorialScript
  m_EditorClassIdentifier: 
  script:
  - name: "\uD560\uC544\uBC84\uC9C0"
    text: "\uC774 \uAE30\uB85D\uC744 \uC77D\uACE0 \uC788\uB2E4\uBA74 \uB098\uB294 \uC774\uBBF8 \uC138\uC0C1\uC5D0 \uC5C6\uACA0\uC9C0\u2026 \uC2AC\uD37C\uD558\uC9C0 \uB9D0\uACE0, \uC5B4\uC11C \uB9C8\uC744\uB85C \uAC00 \uBCF4\uAC70\uB77C."
    portraitID: 0
    tutorialFlag: 1
  - name: "\uD560\uC544\uBC84\uC9C0"
    text: "\uC800\uAE30 \uC2AC\uB77C\uC784\uC774 \uC788\uAD6C\uB098. \uB9C8\uBC95\uC744 \uC2DC\uD5D8\uD574 \uBCF4\uAE30\uC5D0 \uB531 \uC88B\uACA0\uC5B4."
    portraitID: 0
    tutorialFlag: 2
  - name: "\uD560\uC544\uBC84\uC9C0"
    text: "\uB124 \uCC28\uB840\uAC00 \uC2DC\uC791\uB418\uBA74 \uCE74\uB4DC\uB97C \uB450 \uC7A5 \uBF51\uB294\uB2E8\uB2E4."
    portraitID: 0
    tutorialFlag: 3
  - name: "\uD560\uC544\uBC84\uC9C0"
    text: "\uC870\uD569 \uBC84\uD2BC\uC744 \uB204\uB974\uBA74 \uC870\uD569 \uCC3D\uC774 \uC5F4\uB9B0\uB2E8\uB2E4."
    portraitID: 0
    tutorialFlag: 4
  - name: "\uD560\uC544\uBC84\uC9C0"
    text: "\uC870\uD569 \uCC3D\uC5D0\uB294 \uB9C8\uBC95 \uCE78\uACFC \uC18D\uC131 \uCE78\uC774 \uC788\uB2E8\uB2E4. \uB9C8\uBC95\uC5D0 \uB530\uB77C \uCE78\uC774 \uB354 \uC0DD\uAE30\uAE30\uB3C4 \uD558\uC9C0. \uBA3C\uC800 \uCCAB \uBC88\uC9F8 \uCE78\uC5D0 \uB9C8\uBC95 \uCE74\uB4DC\uB97C \uB04C\uC5B4\uB2E4 \uB193\uC544 \uBCF4\uAC70\uB77C."
    portraitID: 0
    tutorialFlag: 5
  - name: "\uD560\uC544\uBC84\uC9C0"
    text: "\uADF8\uB798, \uC798\uD588\uB2E4. \uC774\uC81C \uB450 \uBC88\uC9F8 \uCE78\uC5D0 \uC18D\uC131 \uCE74\uB4DC\uB97C \uB193\uC544 \uBCF4\uC790. \uC9C0\uAE08 \uC4F8 \uC218 \uC788\uB294 \uC18D\uC131\uC740 \uBD88\uBFD0\uC774\uB2C8 Fire\uB97C \uB123\uC73C\uBA74 \uB418\uACA0\uAD6C\uB098."
    portraitID: 0
    tutorialFlag: 6
  - name: "\uD560\uC544\uBC84\uC9C0"
    text: "\uC633\uC9C0. \uC774\uC81C \uC544\uB798\uC758 \uC870\uD569 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uB9C8\uBC95\uC744 \uC2DC\uC804\uD574 \uBCF4\uAC70\uB77C."
    portraitID: 0
    tutorialFlag: 7
  - name: "\uD560\uC544\uBC84\uC9C0"
    text: "\uD5C8\uD5C8, \uC798\uD588\uB2E4. \uC5ED\uC2DC \uB0B4 \uC190\uB140\uB294 \uC7AC\uB2A5\uC774 \uC788\uAD6C\uB098."
    portraitID: 0
    tutorialFlag: 8
  - name: "\uD560\uC544\uBC84\uC9C0"
    text: "\uC774\uC81C \uB9C8\uBC95\uC744 \uB9DE\uD790 \uB300\uC0C1\uC744 \uD074\uB9AD\uD574\uC11C \uACE8\uB77C \uBCF4\uAC70\uB77C."
    portraitID: 0
    tutorialFlag: 9
  - name: "\uD560\uC544\uBC84\uC9C0"
    text: "\uADF8\uB798, \uC81C\uB300\uB85C \uC775\uD614\uAD6C\uB098. \uD560 \uC77C\uC744 \uB9C8\uCCE4\uC73C\uBA74 \uC624\uB978\uCABD \uC704\uC758 Turn End \uBC84\uD2BC\uC744 \uB20C\uB7EC \uCC28\uB840\uB97C \uB118\uACA8 \uBCF4\uAC70\uB77C. \uC801\uC774 \uC6C0\uC9C1\uC778 \uB4A4\uC5D0 \uB2E4\uC2DC \uB124 \uCC28\uB840\uAC00 \uB3CC\uC544\uC628\uB2E8\uB2E4."
    portraitID: 0
    tutorialFlag: 10
  - name: "\uD560\uC544\uBC84\uC9C0"
    text: "\uC774\uC81C \uB0A8\uC740 \uC2AC\uB77C\uC784\uB4E4\uB3C4 \uBB3C\uB9AC\uCCD0 \uBCF4\uAC70\uB77C."
    portraitID: 0
    tutorialFlag: 11
  - name: "\uD560\uC544\uBC84\uC9C0"
    text: "\uC774\uC81C \uC5B4\uC5FF\uD55C \uB9C8\uBC95\uC0AC\uAC00 \uB2E4 \uB418\uC5C8\uAD6C\uB098. \uC2A4\uD14C\uC774\uC9C0\uB97C \uD074\uB9AC\uC5B4\uD560 \uB54C\uB9C8\uB2E4 \uC0C8 \uCE74\uB4DC\uB97C \uC5BB\uC744 \uC218 \uC788\uC73C\uB2C8, \uCC28\uADFC\uCC28\uADFC \uBAA8\uC544 \uBCF4\uAC70\uB77C."
    portraitID: 0
    tutorialFlag: 12
  - name: "\uD560\uC544\uBC84\uC9C0"
    text: "\uC774 \uD560\uC544\uBE44\uB294 \uC774\uB9CC \uAC00 \uBCF4\uB9C8. \uC6CC\uB4DC\uC57C\u2026 \uBAB8 \uC870\uC2EC\uD558\uAC70\uB77C."
    portraitID: 0
    tutorialFlag: 13
  speakerImage:
  - {fileID: 21300000, guid: b445ae1b88bf42fb91869de1e87b3fd0, type: 3}
