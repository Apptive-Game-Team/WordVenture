%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6e31484ae70c46f8b06274aebc4a3191, type: 3}
  m_Name: ActOneDialogues
  m_EditorClassIdentifier:
  wordPortrait: {fileID: 21300000, guid: 4b11d118601649689dbff602bda3aab4, type: 3}
  villagerPortrait: {fileID: 21300000, guid: bba01f481368450997f4104c698ce553, type: 3}
  font: {fileID: 11400000, guid: 57a5956b1f2ebe84daed39db798aa561, type: 2}
  chapters:
  - stageID: 0
    title: "평원 · 돌아갈 집"
    background: {fileID: 21300000, guid: 22934f4ac00e34dfd9cb33569822d181, type: 3}
    lines:
    - wordSpeaking: 0
      text: "이제 나와도 되나요? 슬라임들이 길을 막아서, 꼼짝도 못 하고 있었어요."
    - wordSpeaking: 1
      text: "여기는 괜찮아요. 혹시 슬라임 마왕이 있는 곳을 아세요?"
    - wordSpeaking: 0
      text: "해안 너머로 갔다는 말은 들었어요. 우리 마을도 습격을 받아서… 돌아갈 집이 없네요."
    - wordSpeaking: 1
      text: "…저도요."
    - wordSpeaking: 0
      text: "저희는 다른 마을로 피하려고 해요. 길을 열어 줘서 고마워요."
    - wordSpeaking: 1
      text: "저는 마왕을 찾아야 해요. 가시는 길, 조심하세요."
  - stageID: 1
    title: "해안 · 같은 길 위에서"
    background: {fileID: 21300000, guid: 9d158541f1bf73847a2e9f86172af2ba, type: 3}
    lines:
    - wordSpeaking: 0
      text: "평원에서 만났던 마법사님이네요. 저희도 이 해안길을 따라왔어요."
    - wordSpeaking: 1
      text: "워드라고 불러 주세요. 같이 오신 분들은요? 다들 무사해요?"
    - wordSpeaking: 0
      text: "네. 다만 아이들이 지쳐서, 잠깐 쉬려고요."
    - wordSpeaking: 1
      text: "제가 지나온 길에는 슬라임이 없어요. 저 바위 뒤에서 쉬세요. 바람도 덜 불 거예요."
    - wordSpeaking: 0
      text: "급한 길이라고 하지 않았나요? 이렇게 살펴 줘도 괜찮아요?"
    - wordSpeaking: 1
      text: "잠깐이면 돼요. 아이들이 또 도망치게 하고 싶지는 않아요."
  - stageID: 2
    title: "고원 · 기다려 주는 사람"
    background: {fileID: 21300000, guid: f5eee149beadcfb4bb4bbb74ad433be6, type: 3}
    lines:
    - wordSpeaking: 0
      text: "앞쪽 마을에서도 사람들이 내려오고 있어요. 슬라임들이 다시 몰려온대요."
    - wordSpeaking: 1
      text: "그분들을 해안 쪽으로 데려가 주세요. 제가 올라온 길로 가면 돼요."
    - wordSpeaking: 0
      text: "혼자 더 올라갈 생각이에요? 다친 곳도 있는 것 같은데…"
    - wordSpeaking: 1
      text: "괜찮아요. 대신 뒤처지는 사람이 없는지 봐 주세요."
    - wordSpeaking: 0
      text: "알겠어요. 당신도 꼭 돌아와요. 함께 쉬어 갈 자리는 남겨 둘게요."
    - wordSpeaking: 1
      text: "…고마워요."
  - stageID: 3
    title: "빗길 · 끝내야 하는 이유"
    background: {fileID: 21300000, guid: 0c7860b01c549e643978c99b85b90efe, type: 3}
    lines:
    - wordSpeaking: 0
      text: "마지막으로 내려오던 사람들까지 모두 만났어요. 이제 함께 피할 수 있어요."
    - wordSpeaking: 1
      text: "다행이에요. 더 기다리지 말고, 비가 세지기 전에 내려가세요."
    - wordSpeaking: 0
      text: "마왕이 바로 앞에 있다던데… 정말 가야 하나요?"
    - wordSpeaking: 1
      text: "마왕 때문에 할아버지를 잃었어요. 처음엔 그것만 생각하며 여기까지 왔어요."
    - wordSpeaking: 1
      text: "그런데 이제는, 여러분이 다시 집을 잃지 않았으면 좋겠어요. 여기서 끝낼게요."
    - wordSpeaking: 0
      text: "그럼 길 아래에서 기다릴게요. 꼭 무사히 돌아와요."
  - stageID: 4
    title: "마왕을 쓰러뜨린 뒤 · 돌아가는 길"
    background: {fileID: 21300000, guid: 8eab9287a556d4cba85b2e2409af404b, type: 3}
    lines:
    - wordSpeaking: 0
      text: "워드! 아래에서 기다리다가 올라왔어요. 정말… 끝난 건가요?"
    - wordSpeaking: 1
      text: "네. 마왕은 이제 없어요."
    - wordSpeaking: 0
      text: "이제 돌아가서 마을을 다시 세울 수 있겠네요. 당신 덕분이에요."
    - wordSpeaking: 1
      text: "저도 돌아가려고요. 할아버지께 다녀와야겠어요."
    - wordSpeaking: 0
      text: "쉬어 가고 싶으면 언제든 찾아와요. 이번에는 우리가 맞아 줄게요."
    - wordSpeaking: 1
      text: "…네. 다음에는 급히 지나치지 않을게요."
